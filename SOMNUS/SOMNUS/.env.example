# ---------- CockroachDB ----------
COCKROACH_DB_URL=postgresql://user:password@host:26257/somnus?sslmode=verify-full
COCKROACH_CLUSTER_ID=your-ccloud-cluster-id

# ---------- AWS ----------
# Prefer an IAM role or `aws configure`. boto3 picks credentials up automatically;
# these are only needed if you have no other credential source.
AWS_DEFAULT_REGION=us-east-1
S3_ARCHIVE_BUCKET=your-somnus-archive-bucket

# ---------- Models ----------
# Titan v2 accepts ONLY 1024 / 512 / 256. 1536 is v1 and raises ValidationException.
SOMNUS_EMBED_DIM=1024
SOMNUS_EMBED_MODEL=amazon.titan-embed-text-v2:0
SOMNUS_REASON_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ---------- Runtime ----------
# 1 = in-memory store + local encoder. Everything runs with zero credentials.
SOMNUS_OFFLINE=0
SOMNUS_POLL_INTERVAL=2.0
SOMNUS_EPISODE_TTL_HOURS=24

# ---------- Cognitive parameters (all overridable) ----------
SOMNUS_ACH_HALFLIFE=80
SOMNUS_NA_SLACK=1.2
SOMNUS_NA_THRESHOLD=3.0
SOMNUS_WARMUP_TICKS=25
SOMNUS_ALPHA_BASE=0.06
SOMNUS_HARDEN_AT=8
SOMNUS_INTERLEAVE=0.5
SOMNUS_NOVELTY_THRESHOLD=0.35
